{
  "name": "h5-scorm-editor-desktop",
  "productName": "H5 SCORM Editor",
  "version": "1.0.3",
  "license": "MIT",
  "description": "用于轻量维护 H5 与 SCORM 1.2 课程的本地桌面工具",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck && node scripts/build-desktop.mjs",
    "prepare:resources": "node scripts/prepare-resources.mjs && node scripts/generate-icon.mjs",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "verify:portable": "node scripts/verify-portable.mjs",
    "make": "node scripts/make-windows.mjs",
    "make:forge": "electron-forge make"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/core": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@types/node": "^22.10.5",
    "electron": "^44.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "typescript": "~5.7.2"
  }
}
